<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_gradient_background"
    tools:context=".WelcomeActivity">

    <!-- Personal photo, in the flexible (non-circular) rounded card
         container. clipToOutline on the FrameLayout clips the photo to
         the same rounded-rect shape as its background (API 21+, no
         extra library needed). Container ratio is 9:16 to closely
         match this photo's actual proportions so centerCrop doesn't
         cut off the head/face. -->
    <FrameLayout
        android:id="@+id/welcomePhotoPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="200dp"
        app:layout_constraintDimensionRatio="9:16"
        android:background="@drawable/welcome_photo_placeholder_card"
        android:clipToOutline="true"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/welcomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.38">

        <ImageView
            android:id="@+id/welcomePhotoPlaceholderIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/welcome_personal_photo"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/welcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Welcome Zahin ar YouTube"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/welcomePhotoPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/welcomeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Made by Siam Jong"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:letterSpacing="0.03"
        app:layout_constraintTop_toBottomOf="@id/welcomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/welcomeGetStartedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="56dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:background="@drawable/welcome_button_background"
        android:textColor="#FFFFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
